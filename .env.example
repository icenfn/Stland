# 以下环境变量为**可选覆盖项**。
# 默认配置在 src/config/app.config.json —— 该文件才是「这个包连哪台服务器」的权威来源。
# 环境变量优先级更高，便于 CI 或多环境构建临时改地址，不必改动仓库文件。

# 服务端地址（覆盖 app.config.json 的 api.baseUrl）
# VITE_API_BASE=http://139.196.225.114:8999

# 与服务端 STLAND_SIGN_SECRET 完全一致的共享签名密钥
# VITE_API_SIGN_SECRET=dev-sign-secret-stland

# 是否对所有请求启用 HMAC 请求签名（与服务端 STLAND_SIGNATURE_REQUIRED 对应）
# VITE_API_SIGNATURE=true
