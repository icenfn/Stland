# 客户端与服务端的连接配置
#
# 默认值写在 src/config/app.config.json 里（随源码可审计、可 diff），
# 这里的变量全部是**可选覆盖**，只用于 CI 或本地临时联调。
# 优先级：下面这些环境变量 > app.config.json > 内置兜底。
#
# 换句话说：不设置任何变量也能正常构建，默认连的就是配置文件里的服务器。

# 服务端根地址（覆盖 app.config.json 的 api.baseUrl）
# VITE_API_BASE=http://139.196.225.114:8999

# 单请求超时（毫秒）
# VITE_API_TIMEOUT=15000

# 与服务端 STLAND_SIGN_SECRET 完全一致的共享密钥
# 生产环境务必通过 CI Secret 注入，不要提交真实密钥
# VITE_API_SIGN_SECRET=dev-sign-secret-stland

# 是否对所有请求启用 HMAC 请求签名（对应服务端 STLAND_SIGNATURE_REQUIRED）
# VITE_API_SIGNATURE=false

# 轮询节奏（毫秒）
# VITE_POLL_MARKET_MS=1500
# VITE_POLL_ACCOUNT_MS=5000
