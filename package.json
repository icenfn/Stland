{
  "name": "stland",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stland 股岛 —— Tauri 2 + Vue 3 移动端交易终端",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "icon": "python3 scripts/gen_icon.py src-tauri/icons/icon-source.png && tauri icon src-tauri/icons/icon-source.png -o src-tauri/icons",
    "android:init": "tauri android init",
    "android:build": "tauri android build --apk --target aarch64"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@vueuse/core": "^15.0.0",
    "alova": "^3.5.5",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^2.2.12"
  }
}
