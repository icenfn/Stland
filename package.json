{
  "name": "stland",
  "private": true,
  "version": "1.0.0",
  "description": "Stland 股岛 —— 自包含股票交易系统客户端（Tauri + Vue3）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:build": "tauri android build --apk --target aarch64",
    "android:dev": "tauri android dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-os": "^2.1.0",
    "@vueuse/core": "^11.3.0",
    "alova": "^3.0.5",
    "naive-ui": "^2.40.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
