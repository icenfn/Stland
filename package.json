{
  "name": "stland",
  "private": true,
  "version": "1.0.0",
  "description": "Stland 股岛 —— 自包含股票交易系统客户端（Tauri + Vue3）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/icon-source.png -o src-tauri/icons",
    "android:init": "tauri android init",
    "android:build": "tauri android build --apk --target aarch64",
    "android:dev": "tauri android dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@vueuse/core": "^15.0.0",
    "@zebra-ui/swiper": "^3.0.3",
    "alova": "^3.5.5",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.18.13",
    "@vitejs/plugin-vue": "^6.0.10",
    "sass": "^1.107.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^2.2.12"
  }
}
